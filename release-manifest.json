{
  "schemaVersion": 1,
  "packageName": "local-model-service-platform",
  "directories": [
    ".github",
    "tests",
    "manager-core",
    "platform-mcp",
    "search-gateway",
    "shared-public",
    "scripts",
    "service-entry",
    "tts-platform",
    "vllm-manager",
    "llama-manager",
    "model-capability-tests",
    "vllm",
    "deploy/public"
  ],
  "files": [
    ".gitattributes",
    ".gitignore",
    "README.md",
    "package.json",
    "package-lock.json",
    "playwright.config.cjs",
    "SYNC_POLICY.md",
    "release-manifest.json",
    "install-all.cmd",
    "install-download-cli.cmd",
    "test-all.cmd",
    "start-platform.cmd",
    "stop-platform.cmd",
    "status-platform.cmd",
    "start-service-entry.cmd",
    "start-service-entry-lan.cmd",
    "stop-service-entry.cmd",
    "status-service-entry.cmd",
    "start-tts-platform.cmd",
    "status-tts-platform.cmd",
    "start-search-gateway.cmd",
    "stop-search-gateway.cmd",
    "install-tts-gateway.cmd",
    "update-platform.cmd",
    "start-platform-mcp.cmd",
    "stop-platform-mcp.cmd",
    "status-platform-mcp.cmd",
    "start-claude-vllm-proxy.ps1",
    "claude-vllm-anthropic-proxy.py",
    "build-github-release.ps1"
  ],
  "extraFiles": [
    "deploy/public/.env.example",
    "platform-mcp/.env.example",
    "search-gateway/.env.example",
    "tts-platform/.env.example",
    "docs/client-setup-guide.md",
    "docs/git-worktree-workflow.md",
    "docs/mcp-platform-guide.md",
    "docs/qwen38-acceleration-guide.md",
    "docs/service-runbook.md",
    "docs/model-storage-guide.md",
    "docs/update-guide.md"
  ],
  "runtimeDataDirectories": [
    "service-entry/data",
    "vllm-manager/data",
    "llama-manager/data",
    "tts-platform/voices",
    "tts-platform/outputs",
    "tts-platform/logs"
  ],
  "robocopy": {
    "excludeDirs": [
      "node_modules",
      ".git",
      ".claude",
      "logs",
      "__pycache__",
      ".cache",
      "cache",
      "models",
      "audit-logs",
      "openwebui-exports",
      "venvs",
      "projects",
      "test-results",
      "playwright-report",
      "dist"
    ],
    "excludeFiles": [
      ".env",
      ".env.*",
      ".manager.pid",
      "*.log",
      "*.pid",
      "*.tmp",
      "*.db",
      "*.db-*",
      "*.sqlite",
      "*.sqlite-*",
      "*.sqlite3",
      "*.sqlite3-*",
      "*.jsonl",
      "*.wal",
      "*.shm",
      "*.local.json",
      "*.secret.json",
      "stats-ledger.json",
      "jobs-ledger.json",
      "service-exposure.json",
      "service-api-key.json",
      "manager-public-proxy.js",
      "public-port-proxy.js",
      "start-manager-public-proxy.cmd",
      "stop-manager-public-proxy.cmd",
      "upnp-port-map.js"
    ]
  },
  "forceInclude": [
    "*/test/fixtures/**"
  ],
  "syntaxCheck": {
    "esmGlobs": [
      "service-entry/console/**/*.js",
      "service-entry/portal/**/*.js",
      "shared-public/vendor/**/*.js"
    ],
    "skipGlobs": [
      "shared-public/vendor/**",
      "**/*.min.js"
    ]
  },
  "excluded": [
    { "glob": "docs/overhaul/**", "reason": "internal design specs" },
    { "glob": "docs/design/**", "reason": "design concept images" },
    { "glob": "docs/comprehensive-audit-*.md", "reason": "internal audit notes" },
    { "glob": "docs/fine-grained-feature-audit-2026-06-14.md", "reason": "internal audit snapshot that names machine-local paths" },
    { "glob": "docs/frontend-design-audit-2026-08-11.md", "reason": "internal audit notes" },
    { "glob": "docs/model-service-deep-review-2026-06-14.md", "reason": "internal review that names machine-local paths" },
    { "glob": "docs/platform-audit-remediation-2026-07-10.md", "reason": "internal audit and remediation record" },
    { "glob": "docs/security-hardening-2026-08-04.md", "reason": "internal change record" },
    { "glob": "docs/model-service-platform-workplan.md", "reason": "internal work plan" },
    { "glob": "docs/multi-model-fleet.md", "reason": "internal design note; not part of the release documentation set" },
    { "glob": "docs/billing-guide.md", "reason": "owner deployment notes that name the owner's public endpoints" }
  ]
}
