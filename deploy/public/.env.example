# Only needed when you run openwebui.compose.yaml by hand. The rendered files from
# scripts/setup-public.ps1 already contain the domains; the key is never rendered.
WEBUI_DOMAIN=chat.example.com
MODEL_API_DOMAIN=models.example.com
# A key you created in the console (preset "internal-app"), for OpenWebUI only.
MODEL_GATEWAY_API_KEY=replace-with-an-internal-app-key
