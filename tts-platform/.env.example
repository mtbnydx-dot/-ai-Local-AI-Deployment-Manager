# 复制此文件为 .env 并填入你的 API Key（没有的可以留空，对应引擎会显示"未配置"）

# ---- 统一入口 / 本机安全 ----
# 7000 默认只监听 127.0.0.1；通过 service-entry 的 /gateway/tts/ 对外提供。
# 如需给 7000 自身再加一层 Bearer 保护，请同时给 service-entry 配置同值的
# TTS_UPSTREAM_API_KEY。正常的回环部署可以留空。
TTS_API_KEY=
PUBLIC_PREFIX=
# 运行数据可单独放盘；不填时使用 tts-platform 目录。启动脚本端口默认 7000。
TTS_DATA_ROOT=
TTS_GATEWAY_PORT=7000
# 独立运行时与模型目录；留空时使用 <AI_ROOT>\tts-runtime。
TTS_RUNTIME_ROOT=
TTS_MAX_UPLOAD_BYTES=10485760
TTS_MAX_TEXT_CHARS=10000
TTS_MAX_TRANSLATE_CHARS=12000
TTS_MAX_STYLE_CHARS=500
TTS_MAX_BATCH_ENGINES=3
TTS_MAX_CONCURRENT_JOBS=2
TTS_JOB_RETENTION=200
TTS_FFMPEG_TIMEOUT_SECONDS=90
TTS_ENGINE_PROBE_TIMEOUT_SECONDS=2
TTS_ENGINE_PROBE_TTL_SECONDS=8

# ---- 小米 MiMo 开放平台 https://platform.xiaomimimo.com （限时免费，支持音色克隆）----
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_CLONE_MODEL=mimo-v2.5-tts-voiceclone
MIMO_CHAT_MODEL=mimo-v2.5

# ---- 本地大模型平台（翻译优先走这里，service-entry 统一网关）----
LOCAL_LLM_BASE=http://127.0.0.1:5176/gateway/auto/openai/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# ---- 阿里云百炼 DashScope https://bailian.console.aliyun.com （qwen3-tts 预置音色 + 翻译）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TTS_API_MODEL=qwen3-tts-flash
QWEN_TTS_API_VOICE=Cherry
TRANSLATE_MODEL=qwen-plus

# ---- 可选新增本地模型（通常由网页“模型”页自动设置）----
QWEN_DESIGN_MODEL=
VOXCPM_MODEL=
