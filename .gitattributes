* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gguf binary

# Vendored browser files are pinned by sha256 in shared-public/vendor/VENDOR.json,
# so git stores and checks them out byte for byte (LICENSE files have no extension).
shared-public/vendor/** -text
