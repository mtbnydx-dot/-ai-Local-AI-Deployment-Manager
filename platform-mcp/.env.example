# HTTP is loopback-only by design. Do not bind this service to 0.0.0.0.
PLATFORM_MCP_HOST=127.0.0.1
PLATFORM_MCP_PORT=5190

# Required for Streamable HTTP. Generate a random value of at least 32 characters.
PLATFORM_MCP_API_KEY=replace-with-a-random-local-secret

# Fixed, allowlisted local upstreams. No client can override these URLs.
PLATFORM_MCP_SERVICE_ENTRY_URL=http://127.0.0.1:5176
PLATFORM_MCP_VLLM_MANAGER_URL=http://127.0.0.1:5177
PLATFORM_MCP_LLAMA_MANAGER_URL=http://127.0.0.1:5178
PLATFORM_MCP_SEARCH_GATEWAY_URL=http://127.0.0.1:5180

# Required only for local_ai_search_web. Inject from a secret store; never
# commit the real search-gateway key. The Windows start script reads the
# existing manager service-key file without copying it into server.env.
PLATFORM_MCP_SEARCH_GATEWAY_API_KEY=
PLATFORM_MCP_SEARCH_RATE_LIMIT_PER_MINUTE=20

# host.docker.internal lets Docker-hosted clients such as Open WebUI reach the
# loopback-published service without opening it to the LAN.
PLATFORM_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,::1,host.docker.internal
PLATFORM_MCP_TIMEOUT_MS=7000
PLATFORM_MCP_MAX_RESPONSE_CHARS=25000
