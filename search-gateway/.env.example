# Optional: copy to .env in this directory and adjust before running docker compose.

# The model endpoint seen from inside Docker. The default is a drop-in replacement
# for the public/local vLLM OpenAI endpoint that is usually exposed on 18080.
# Alternatives:
#   http://host.docker.internal:5177/serve/v1
#   http://host.docker.internal:5176/gateway/auto/openai/v1
UPSTREAM_BASE_URL=http://host.docker.internal:18080/v1

# If your model gateway requires a fixed server-side key, put it here.
# If empty, caller Authorization is forwarded upstream.
UPSTREAM_API_KEY=

# Recommended when exposing port 5180 to other machines.
# Callers then use: Authorization: Bearer <this value>
SEARCH_GATEWAY_API_KEY=

# auto = search only for likely current/web questions; always = search every chat; off = passthrough only.
SEARCH_MODE=auto
SEARCH_MAX_RESULTS=8

# Engine orchestration, selected from repeated local relevance/availability
# probes in Chinese and English. Yandex is only a one-pass fallback.
SEARCH_DEFAULT_ENGINES=searchtoday
SEARCH_CHINESE_ENGINES=
SEARCH_FALLBACK_ENGINES=yandex
SEARCH_BLOCKED_DOMAINS=ai.so.com
SEARCH_MIN_RELEVANCE=0.16
SEARCH_MAX_CONCURRENT=2

# Short-lived result/session state reduces duplicate engine requests while
# keeping current-news searches refreshable.
SEARCH_CACHE_TTL_MS=600000
SEARCH_NEGATIVE_CACHE_TTL_MS=60000
SEARCH_SESSION_TTL_MS=900000
SEARCH_BACKEND_TIMEOUT_MS=15000

# Safe result-page reader bounds.
SEARCH_READ_TIMEOUT_MS=12000
SEARCH_READ_MAX_BYTES=6291456
SEARCH_READ_MAX_REDIRECTS=3
SEARCH_READ_MAX_EXTRACT_CHARS=60000
SEARCH_READ_MAX_PDF_PAGES=80
SEARCH_READ_CACHE_TTL_MS=300000

# Public listener for the OpenAI-compatible search gateway.
SEARCH_GATEWAY_BIND=0.0.0.0
SEARCH_GATEWAY_PUBLIC_PORT=5180

# SearXNG is only published to localhost for local diagnostics.
SEARXNG_LOCAL_PORT=8180

# Optional reproducibility pin, for example docker.io/searxng/searxng@sha256:...
SEARXNG_IMAGE=docker.io/searxng/searxng:latest
