# Optional: copy to .env in this directory and adjust before running docker compose.

# The model endpoint seen from inside Docker. The default is a drop-in replacement
# for the public/local vLLM OpenAI endpoint that is usually exposed on 18080.
# Alternatives:
#   http://host.docker.internal:5177/serve/v1
#   http://host.docker.internal:5176/gateway/auto/openai/v1
UPSTREAM_BASE_URL=http://host.docker.internal:18080/v1

# If your model gateway requires a fixed server-side key, put it here.
# If empty, caller Authorization is forwarded upstream.
UPSTREAM_API_KEY=

# Recommended when exposing port 5180 to other machines.
# Callers then use: Authorization: Bearer <this value>
SEARCH_GATEWAY_API_KEY=

# auto = search only for likely current/web questions; always = search every chat; off = passthrough only.
SEARCH_MODE=auto
SEARCH_MAX_RESULTS=5

# Public listener for the OpenAI-compatible search gateway.
SEARCH_GATEWAY_BIND=0.0.0.0
SEARCH_GATEWAY_PUBLIC_PORT=5180

# SearXNG is only published to localhost for local diagnostics.
SEARXNG_LOCAL_PORT=8180
