                          },
                          0
                        ]
                      },
                      {
                        "user": "sglang.dsparkBlockSize"
                      },
                      null
                    ]
                  },
                  7
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "validation": [
    {
      "kind": "draftArchitecture",
