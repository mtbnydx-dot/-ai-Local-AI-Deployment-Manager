      "message": {
        "zh": "该 checkpoint 的约 51GB PLE embedding 必须放入 128GB 系统内存；请启用 PLE embedding → CPU RAM。",
        "en": "This checkpoint's PLE embedding (about 51 GB) must live in the 128 GB of system RAM; enable PLE embedding to CPU RAM."
      }
    },
    {
      "kind": "rule",
      "severity": "fail",
      "code": "flashnext_speculative_off",
      "when": {
        "ne": [
          {
            "coalesce": [
              {
                "user": "speculative.method"
