              },
              "flashinfer"
            ]
          }
        ]
      },
      "title": {
        "zh": "Linear attention decode 不匹配",
        "en": "Linear attention decode mismatch"
      },
      "message": {
        "zh": "262K 稳定档要求 flashinfer，当前选择 {{user:sglang.linearAttnDecodeBackend}}。",
        "en": "The 262K stable recipe requires flashinfer; {{user:sglang.linearAttnDecodeBackend}} is selected."
      }
    },
    {
      "kind": "rule",
      "severity": "fail",
      "code": "flashnext_mamba_dtype",
