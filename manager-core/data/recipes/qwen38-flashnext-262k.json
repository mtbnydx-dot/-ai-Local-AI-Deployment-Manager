              },
              "triton"
            ]
          }
        ]
      },
      "title": {
        "zh": "QSA / attention backend 不匹配",
        "en": "QSA / attention backend mismatch"
      },
      "message": {
        "zh": "262K 稳定档要求 triton，当前选择 {{user:sglang.attentionBackend}}。",
        "en": "The 262K stable recipe requires triton; {{user:sglang.attentionBackend}} is selected."
      }
    },
    {
      "kind": "rule",
      "severity": "fail",
      "code": "flashnext_linear_prefill_backend",
