      "message": {
        "zh": "QSA 路径仍有 query BF16 与 K/V FP8 dtype mismatch；请把 KV cache 精度设为 auto（当前会得到 BF16）。",
        "en": "The QSA path still has a query BF16 versus K/V FP8 dtype mismatch; set the KV cache precision to auto (BF16 for now)."
      }
    },
    {
      "kind": "rule",
      "severity": "fail",
      "code": "flashnext_attention_backend",
