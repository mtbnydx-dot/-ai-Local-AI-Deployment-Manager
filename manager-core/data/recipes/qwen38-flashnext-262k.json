        "and": [
          {
            "isSet": {
              "user": "sglang.linearAttnPrefillBackend"
            }
          },
          {
            "ne": [
              {
                "user": "sglang.linearAttnPrefillBackend"
              },
              "triton"
            ]
          }
        ]
      },
      "title": {
        "zh": "Linear attention prefill 不匹配",
        "en": "Linear attention prefill mismatch"
      },
      "message": {
        "zh": "262K 稳定档要求 triton，当前选择 {{user:sglang.linearAttnPrefillBackend}}。",
        "en": "The 262K stable recipe requires triton; {{user:sglang.linearAttnPrefillBackend}} is selected."
      }
    },
    {
      "kind": "rule",
      "severity": "fail",
      "code": "flashnext_linear_decode_backend",
