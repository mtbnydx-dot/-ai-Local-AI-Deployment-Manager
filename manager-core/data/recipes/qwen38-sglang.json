{
  "schemaVersion": 1,
  "asOf": "2026-10-14",
  "staleAfterDays": 180,
  "id": "qwen38-sglang",
  "kind": "model",
  "status": "verified",
  "label": {
    "zh": "Qwen3.8 · SGLang · FlashInfer",
