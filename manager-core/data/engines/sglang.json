{
  "schemaVersion": 1,
  "asOf": "2026-10-14",
  "staleAfterDays": 120,
  "id": "sglang",
  "label": { "zh": "SGLang", "en": "SGLang" },
  "description": {
    "zh": "长上下文与 Flash-Next 路径；Linux/Docker。",
    "en": "Long-context and Flash-Next path; Linux/Docker only."
  },
  "family": "sglang",
  "adapter": "sglang",
  "tier": 1,
  "status": "stable",
  "hostManager": "vllm",
  "legacy": { "engineLabel": "sglang", "managerEngineField": "sglang" },
  "artifactFormats": ["safetensors", "fp8", "nvfp4", "awq", "gptq"],
  "runtimes": {
    "default": "sglang",
    "allowed": ["sglang", "sglangFlashNext", "sglangPennyroyal", "sglangFlashNextNvme"],
    "envOverride": { "sglang": "SGLANG_IMAGE", "sglangFlashNext": "SGLANG_FLASH_NEXT_IMAGE" },
    "allowCustomImage": true
  },
  "host": {
    "kinds": ["docker"],
    "default": "docker",
    "containerPort": 8000,
    "ipc": "host",
    "init": false,
    "ulimits": [],
    "restart": "on-failure:3",
    "gpus": "required",
    "allowLan": true,
    "healthcheck": { "cmd": "curl -fsS http://127.0.0.1:8000/health || exit 1", "interval": "30s", "timeout": "5s", "retries": 3 },
    "cacheMounts": [
      { "configKey": "hfCache", "target": "/root/.cache/huggingface" },
      { "configKey": "sglangCache", "target": "/root/.cache" }
    ]
  },
  "api": {
    "openaiBase": "/v1",
    "models": "/v1/models",
    "health": "/health",
    "version": ["/get_server_info", "/server_info"],
    "ready": { "kind": "models-list" },
    "probe": { "kind": "chat-generation", "maxTokens": 32 }
  },
  "apiSurface": { "chat": true, "completions": true, "responses": true, "messages": true, "embeddings": false, "rerank": false },
  "apiQuirks": { "reasoningField": "reasoning_content" },
  "catalog": "launch-params/sglang.json",
  "memoryModel": { "kind": "static-fraction-of-free", "fractionParam": "sglang.memFractionStatic", "poolTokensParam": "sglang.maxTotalTokens" },
  "capabilities": {
    "parallelInstances": true,
    "tensorParallel": true,
    "pipelineParallel": true,
    "dataParallel": true,
    "expertParallel": true,
    "speculative": ["DSPARK", "NEXTN", "EAGLE", "EAGLE3", "STANDALONE", "NGRAM"],
    "autoParsers": { "tool": null, "reasoning": null },
    "lora": true,
    "multiModel": false,
    "hotLoad": false,
    "sleepWake": false,
    "roles": ["chat", "embedding"]
  },
  "knowledgeKeys": [],
  "secrets": { "apiKey": { "mode": "flag", "flag": "--api-key" } },
  "managedFlags": ["--model-path", "--served-model-name", "--host", "--port", "--api-key", "--enable-metrics"],
  "extraEnvAllow": ["SGLANG_", "NCCL_", "PYTORCH_", "TORCH_", "TRITON_", "FLASHINFER_"],
  "introspection": { "entrypoint": "python3", "argv": ["-m", "sglang.launch_server", "--help"], "parser": "argparse" },
  "metricsMap": {
    "path": "/metrics",
    "format": "prometheus",
    "map": {
      "promptTokensTotal": [{ "name": "sglang:prompt_tokens_total", "kind": "counter" }],
      "generationTokensTotal": [{ "name": "sglang:generation_tokens_total", "kind": "counter" }],
      "cachedPromptTokensTotal": [{ "name": "sglang:cached_tokens_total", "kind": "counter" }],
      "requestsTotal": [{ "name": "sglang:num_requests_total", "kind": "counter" }],
      "prefixQueriesTotal": [{ "name": "sglang:prompt_tokens_total", "kind": "counter" }],
      "prefixHitsTotal": [{ "name": "sglang:cached_tokens_total", "kind": "counter" }],
      "specDraftsTotal": [{ "name": "sglang:spec_verify_calls_total", "kind": "counter" }],
      "requestsRunning": [{ "name": "sglang:num_running_reqs", "kind": "gauge" }],
      "requestsWaiting": [{ "name": "sglang:num_queue_reqs", "kind": "gauge" }],
      "kvUsageRatio": [{ "name": "sglang:full_token_usage", "kind": "gauge" }, { "name": "sglang:token_usage", "kind": "gauge" }],
      "kvCapacityTokens": [{ "name": "sglang:max_total_num_tokens", "kind": "gauge" }],
      "specAcceptRate": [{ "name": "sglang:spec_accept_rate", "kind": "gauge" }],
      "genThroughputTps": [{ "name": "sglang:gen_throughput", "kind": "gauge" }],
      "ttftSeconds": [{ "name": "sglang:time_to_first_token_seconds", "kind": "histogram" }],
      "itlSeconds": [{ "name": "sglang:inter_token_latency_seconds", "kind": "histogram" }],
      "tpotSeconds": [{ "name": "sglang:request_time_per_output_token_seconds", "kind": "histogram" }],
      "e2eSeconds": [{ "name": "sglang:e2e_request_latency_seconds", "kind": "histogram" }],
      "queueSeconds": [{ "name": "sglang:queue_time_seconds", "kind": "histogram" }]
    }
  },
  "logPhases": [
    {"match":"application startup complete|uvicorn running|startup complete|fired up and ready to roll","phase":"api","percent":92,"stageText":{"zh":"启动收尾","en":"Finishing startup"},"detailText":{"zh":"服务进程已报告启动完成，正在等待 API 就绪。","en":"The server reported startup complete; waiting for the API."}},
    {"match":"\\b(?:capturing|capture)\\b[^\\r\\n]*cuda graphs?","phase":"graphs","percent":82,"stageText":{"zh":"捕获 CUDA graphs","en":"Capturing CUDA graphs"},"detailText":{"zh":"正在捕获 CUDA graphs。","en":"Capturing CUDA graphs."}},
    {"match":"loading weights|loading model weights|loaded weights|load weight (?:begin|end)|loading base model","phase":"weights","percent":68,"stageText":{"zh":"加载权重","en":"Loading weights"},"detailText":{"zh":"正在加载模型权重。","en":"Loading the model weights."}},
    {"match":"Load weight end","phase":"weights","percent":72,"stageText":{"zh":"加载权重","en":"Loading weights"},"detailText":{"zh":"权重已加载，正在分析显存。","en":"Weights are loaded; profiling memory."}},
    {"match":"max_total_num_tokens=\\d+|KV Cache is allocated","phase":"kv","percent":76,"stageText":{"zh":"分配 KV cache","en":"Allocating KV cache"},"detailText":{"zh":"正在分配 KV cache。","en":"Allocating the KV cache."}}
  ],
  "logFacts": [
    {"id":"weightsGiB","match":"Load weight end\\..*mem usage=([\\d.]+) GB"},
    {"id":"kvTokens","match":"max_total_num_tokens=(\\d+)","type":"int"},
    {"id":"kvGiB","match":"KV Cache is allocated\\..*K size: ([\\d.]+) GB, V size: ([\\d.]+) GB","group":[1,2]}
  ],
  "errorSignatures": [
    {"id":"sglang-flag-unknown","code":"flag_unknown","phase":"container","rootCause":true,"severity":"error","regex":"unrecognized arguments: (--\\S+)","title":{"zh":"运行时不认识参数 {1}","en":"The runtime does not recognize argument {1}"},"hint":{"zh":"刷新运行时的参数自省，或移除该额外参数。","en":"Refresh the runtime flag introspection, or remove that extra argument."},"explanation":{"zh":"镜像比启动参数旧，或额外参数拼写有误。","en":"The image is older than the argument, or the extra argument is misspelled."},"suggestions":[{"kind":"action","action":"introspect"}]}
  ]
}
