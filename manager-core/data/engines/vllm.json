{
  "schemaVersion": 1,
  "asOf": "2026-10-14",
  "staleAfterDays": 120,
  "id": "vllm",
  "label": { "zh": "vLLM", "en": "vLLM" },
  "description": {
    "zh": "通用高吞吐推理引擎：safetensors、FP8/NVFP4 与实验性 GGUF；Linux/Docker。",
    "en": "General high-throughput engine for safetensors, FP8/NVFP4 and experimental GGUF; Linux/Docker only."
  },
  "family": "vllm",
  "adapter": "vllm",
  "tier": 1,
  "status": "stable",
  "hostManager": "vllm",
  "legacy": { "engineLabel": "vllm", "managerEngineField": "vllm" },
  "artifactFormats": ["safetensors", "fp8", "nvfp4", "awq", "gptq", "gguf"],
  "runtimes": {
    "default": "vllm",
    "allowed": ["vllm", "vllmQwenMoe", "vllmGemma"],
    "envOverride": {
      "vllm": ["VLLM_IMAGE", { "env": "VLLM_IMAGE_VERSION", "template": "vllm/vllm-openai:{value}" }],
      "vllmQwenMoe": "VLLM_QWEN_MOE_IMAGE",
      "vllmGemma": "VLLM_GEMMA_IMAGE"
    },
    "allowCustomImage": true
  },
  "host": {
    "kinds": ["docker"],
    "default": "docker",
    "containerPort": 8000,
    "ipc": "host",
    "init": false,
    "ulimits": [],
    "restart": "on-failure:3",
    "gpus": "required",
    "allowLan": true,
    "healthcheck": { "cmd": "curl -fsS http://127.0.0.1:8000/health || exit 1", "interval": "30s", "timeout": "5s", "retries": 3 },
    "cacheMounts": [
      { "configKey": "hfCache", "target": "/root/.cache/huggingface" },
      { "configKey": "vllmCache", "target": "/root/.cache/vllm" }
    ]
  },
  "api": {
    "openaiBase": "/v1",
    "models": "/v1/models",
    "health": "/health",
    "version": ["/version"],
    "ready": { "kind": "models-list" },
    "probe": { "kind": "chat-generation", "maxTokens": 32 }
  },
  "apiSurface": { "chat": true, "completions": true, "responses": true, "messages": false, "embeddings": false, "rerank": false },
  "apiQuirks": { "reasoningField": "reasoning" },
  "catalog": "launch-params/vllm.json",
  "memoryModel": { "kind": "device-fraction", "fractionParam": "vllm.gpuMemoryUtilization" },
  "capabilities": {
    "parallelInstances": true,
    "tensorParallel": true,
    "pipelineParallel": true,
    "dataParallel": true,
    "expertParallel": true,
    "speculative": ["mtp", "eagle", "eagle3", "draft_model", "ngram"],
    "autoParsers": { "tool": null, "reasoning": null },
    "lora": true,
    "multiModel": false,
    "hotLoad": false,
    "sleepWake": false,
    "roles": ["chat", "embedding", "rerank"]
  },
  "knowledgeKeys": ["reasoningParser", "toolCallParser", "enableAutoToolChoice", "forceTrustRemoteCode", "env", "requiredPluginFile", "speculative"],
  "secrets": { "apiKey": { "mode": "env", "env": "VLLM_API_KEY" } },
  "managedFlags": ["--model", "--served-model-name", "--host", "--port", "--api-key"],
  "extraEnvAllow": ["VLLM_", "NCCL_", "PYTORCH_", "TORCH_", "TRITON_", "FLASHINFER_"],
  "introspection": { "entrypoint": "vllm", "argv": ["serve", "--help=all"], "parser": "argparse" },
  "metricsMap": {
    "path": "/metrics",
    "format": "prometheus",
    "map": {
      "promptTokensTotal": [{ "name": "vllm:prompt_tokens_total", "kind": "counter" }],
      "generationTokensTotal": [{ "name": "vllm:generation_tokens_total", "kind": "counter" }],
      "cachedPromptTokensTotal": [{ "name": "vllm:prompt_tokens_cached_total", "kind": "counter" }],
      "requestsTotal": [{ "name": "vllm:request_success_total", "kind": "counter" }, { "name": "vllm:request_prompt_tokens_count", "kind": "counter" }],
      "requestsByFinishReason": [{ "name": "vllm:request_success_total", "kind": "counter", "label": "finished_reason" }],
      "prefixQueriesTotal": [{ "name": "vllm:prefix_cache_queries_total", "kind": "counter" }],
      "prefixHitsTotal": [{ "name": "vllm:prefix_cache_hits_total", "kind": "counter" }],
      "preemptionsTotal": [{ "name": "vllm:num_preemptions_total", "kind": "counter" }],
      "specDraftTokensTotal": [{ "name": "vllm:spec_decode_num_draft_tokens_total", "kind": "counter" }, { "name": "vllm:spec_decode_draft_tokens_total", "kind": "counter" }],
      "specAcceptedTokensTotal": [{ "name": "vllm:spec_decode_num_accepted_tokens_total", "kind": "counter" }, { "name": "vllm:spec_decode_num_accepted_tokens", "kind": "counter" }, { "name": "vllm:spec_decode_accepted_tokens_total", "kind": "counter" }],
      "specDraftsTotal": [{ "name": "vllm:spec_decode_num_drafts_total", "kind": "counter" }, { "name": "vllm:spec_decode_num_drafts", "kind": "counter" }],
      "requestsRunning": [{ "name": "vllm:num_requests_running", "kind": "gauge" }],
      "requestsWaiting": [{ "name": "vllm:num_requests_waiting", "kind": "gauge" }],
      "kvUsageRatio": [{ "name": "vllm:kv_cache_usage_perc", "kind": "gauge" }],
      "ttftSeconds": [{ "name": "vllm:time_to_first_token_seconds", "kind": "histogram" }],
      "itlSeconds": [{ "name": "vllm:inter_token_latency_seconds", "kind": "histogram" }],
      "tpotSeconds": [{ "name": "vllm:request_time_per_output_token_seconds", "kind": "histogram" }],
      "e2eSeconds": [{ "name": "vllm:e2e_request_latency_seconds", "kind": "histogram" }],
      "queueSeconds": [{ "name": "vllm:request_queue_time_seconds", "kind": "histogram" }]
    }
  },
  "logPhases": [
    {"match":"application startup complete|uvicorn running|startup complete","phase":"api","percent":92,"stageText":{"zh":"启动收尾","en":"Finishing startup"},"detailText":{"zh":"服务进程已报告启动完成，正在等待 API 就绪。","en":"The server reported startup complete; waiting for the API."}},
    {"match":"\\b(?:capturing|capture)\\b[^\\r\\n]*cuda graphs?","phase":"graphs","percent":82,"stageText":{"zh":"捕获 CUDA graphs","en":"Capturing CUDA graphs"},"detailText":{"zh":"正在捕获 CUDA graphs。","en":"Capturing CUDA graphs."}},
    {"match":"loading weights|loading model weights|loaded weights|load weight (?:begin|end)|loading base model","phase":"weights","percent":68,"stageText":{"zh":"加载权重","en":"Loading weights"},"detailText":{"zh":"正在加载模型权重。","en":"Loading the model weights."}},
    {"match":"Model loading took [\\d.]+ GiB","phase":"weights","percent":72,"stageText":{"zh":"加载权重","en":"Loading weights"},"detailText":{"zh":"权重已加载，正在分析显存。","en":"Weights are loaded; profiling memory."}},
    {"match":"Available KV cache memory: [\\d.]+ GiB|GPU KV cache size: [\\d,]+ tokens","phase":"kv","percent":76,"stageText":{"zh":"分配 KV cache","en":"Allocating KV cache"},"detailText":{"zh":"正在分配 KV cache。","en":"Allocating the KV cache."}}
  ],
  "logFacts": [
    {"id":"weightsGiB","match":"Model loading took ([\\d.]+) GiB"},
    {"id":"modelLoadSeconds","match":"Model loading took [\\d.]+ GiB(?: memory)? and ([\\d.]+) seconds"},
    {"id":"kvGiB","match":"Available KV cache memory: ([\\d.]+) GiB"},
    {"id":"kvTokens","match":"GPU KV cache size: ([\\d,]+) tokens","type":"int"},
    {"id":"maxConcurrency","match":"Maximum concurrency for [\\d,]+ tokens per request: ([\\d.]+)x"},
    {"id":"maxContextTokens","match":"Maximum concurrency for ([\\d,]+) tokens per request","type":"int"},
    {"id":"torchCompileSeconds","match":"torch\\.compile took ([\\d.]+) s"},
    {"id":"warmupSeconds","match":"Initial profiling/warmup run took ([\\d.]+) s"},
    {"id":"graphCaptureGiB","match":"Graph capturing finished in [\\d.]+ secs, took ([\\d.]+) GiB"},
    {"id":"engineInitSeconds","match":"init engine .* took ([\\d.]+) s"}
  ],
  "errorSignatures": [
    {"id":"vllm-flag-unknown","code":"flag_unknown","phase":"container","rootCause":true,"severity":"error","regex":"unrecognized arguments: (--\\S+)","title":{"zh":"运行时不认识参数 {1}","en":"The runtime does not recognize argument {1}"},"hint":{"zh":"刷新运行时的参数自省，或移除该额外参数。","en":"Refresh the runtime flag introspection, or remove that extra argument."},"explanation":{"zh":"镜像比启动参数旧，或额外参数拼写有误。","en":"The image is older than the argument, or the extra argument is misspelled."},"suggestions":[{"kind":"action","action":"introspect"}]}
  ]
}
