{
  "schemaVersion": 1,
  "asOf": "2026-09-03",
  "staleAfterDays": 120,
  "notes": "Model capability matrix keyed by declared identity (config.json model_type / architectures, GGUF general.architecture). Name patterns are the last resort and are counted as heuristics. Entries are evaluated in order; the first match wins. confidence=verified means the combination was launched on this platform; documented means it follows the engine documentation but has not been exercised here.",
  "entries": [
    {
      "id": "muse-glimmer",
      "label": "Muse Glimmer",
      "confidence": "verified",
      "match": {
        "modelTypes": ["muse_glimmer"],
        "architecturePatterns": ["^museglimmer"],
        "ggufArchitectures": ["muse-glimmer"],
        "namePatterns": ["museglimmer"]
      },
      "vllm": {
        "supported": false,
        "unsupportedCode": "muse_glimmer",
        "unsupportedReason": "Muse Glimmer has been retired from this local stack and is not a supported launch target."
      },
      "llama": {
        "supported": false,
        "unsupportedReason": "Muse Glimmer 已从本地栈弃用，llama-manager 不再启动该架构。"
      },
      "download": { "level": "block", "reason": "Muse Glimmer 已从本地栈弃用，两个引擎都不会启动它。" },
      "notes": ["Existing weights and the retired local image stay on disk for rollback only."]
    },
    {
      "id": "nemotron-3-nano",
      "label": "NVIDIA Nemotron 3 Nano",
      "confidence": "verified",
      "match": {
        "namePatterns": ["nemotron[-_ ]?3[-_ ]?nano"],
        "architecturePatterns": ["^nemotron.*nano", "^nemotronh"]
      },
      "vllm": {
        "reasoningParser": "nano_v3",
        "requiredPluginFile": "nano_v3_reasoning_parser.py",
        "toolCallParser": "qwen3_coder",
        "enableAutoToolChoice": true,
        "forceTrustRemoteCode": true,
        "env": { "VLLM_USE_FLASHINFER_MOE_FP4": "1", "VLLM_FLASHINFER_MOE_BACKEND": "throughput" },
        "speculative": { "auto": "mtp", "reason": "Nemotron 3 Nano ships MTP heads; auto mode uses them when the packaged tensors are present." }
      },
      "download": { "level": "warn", "reason": "需要把 nano_v3_reasoning_parser.py 放进模型目录（仓库通常自带），并开启 trust_remote_code。" },
      "notes": ["Nemotron 3 Nano uses its checkpoint-specific reasoning parser plugin and qwen3_coder tool parser."]
    },
    {
      "id": "qwen3.8-flash-next",
      "label": "Qwen3.8 Flash-Next (Qwen4 preview)",
      "confidence": "verified",
      "match": {
        "modelTypes": ["qwen4_exp"],
        "architecturePatterns": ["^qwen4exp"],
        "namePatterns": ["flash[-_. ]?next"]
      },
      "contextMax": 262144,
      "vllm": {
        "reasoningParser": "qwen3",
        "toolCallParser": "qwen3_coder",
        "enableAutoToolChoice": true,
        "forceTrustRemoteCode": true,
        "speculative": { "auto": "off", "reason": "Flash-Next on SM120 is validated with NEXTN inside SGLang only; vLLM MTP stays off." }
      },
      "sglang": {
        "image": "sglangFlashNext",
        "imageRequiresQuant": "nvfp4|modelopt_fp4|fp4",
        "kvCacheDtype": "auto",
        "maxNumSeqs": 1,
        "speculative": { "auto": "nextn", "reason": "NEXTN speculation with breakable CUDA graphs is the validated single-card path." }
      },
      "llama": { "supported": false, "unsupportedReason": "Flash-Next 尚无 GGUF 转换路径。" },
      "download": { "level": "info", "reason": "只有 NVFP4 权重 + 本地 SGLang Flash-Next SM120 镜像被验证过；需要 96 GB 显存的 SM 12.0 GPU。" },
      "requires": { "minimumComputeCapability": "12.0", "runtime": "sglangFlashNext" }
    },
    {
      "id": "qwen3.8",
      "label": "Qwen3.8",
      "confidence": "verified",
      "match": {
        "modelTypes": ["qwen3_8", "qwen3_8_moe"],
        "architecturePatterns": ["^qwen3_?8"],
        "namePatterns": ["qwen3[._]?8(?![0-9])"]
      },
      "contextMax": 262144,
      "vllm": {
        "reasoningParser": "qwen3",
        "toolCallParser": "qwen3_coder",
        "enableAutoToolChoice": true,
        "speculative": { "auto": "mtp", "autoOffForQuant": "nvfp4|modelopt", "reason": "Qwen3.8 packages MTP tensors; auto MTP stays off on ModelOpt/NVFP4 checkpoints until acceptance is validated." }
      },
      "sglang": { "speculative": { "auto": "dspark", "reason": "DSpark draft on SGLang is the measured fast path for Qwen3.8-27B." } },
      "llama": { "ggufArchitectures": ["qwen3_8", "qwen38"], "speculative": { "auto": "dflash", "reason": "Use the DFlash draft GGUF when it sits next to the main model." } }
