{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Knowledge file of kind error-signatures (docs/overhaul/02-models.md 8.4). Engine descriptors' errorSignatures[] additions use the same entry schema. The loader renames the deprecated key stage to phase and derives a missing code from the id before validating. Entries are validated one by one; extra keys are accepted.",
  "title": "Error signatures",
  "type": "object",
  "required": ["kind", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "error-signatures" },
    "asOf": { "$ref": "#/$defs/date" },
    "staleAfterDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "pack": { "type": "object" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:[T ].*)?$" },
    "i18n": {
      "type": "object",
      "minProperties": 1,
      "properties": { "zh": { "type": "string", "maxLength": 600 }, "en": { "type": "string", "maxLength": 600 } },
      "additionalProperties": false
    },
    "suggestion": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["probe", "param", "runtime", "recipe", "docs", "action"] },
        "param": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._]{0,79}$" },
        "to": {},
        "security": { "type": "boolean" },
        "action": { "type": "string", "maxLength": 80 }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "code", "regex"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "$merge": { "const": "deep" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "engines": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "pattern": "^(?:\\*|[a-z][a-z0-9-]{1,31})$" } },
        "phase": { "enum": ["pull", "admission", "container", "weights", "kv", "graphs", "api", "probe", "ready"] },
        "rootCause": { "type": "boolean" },
        "severity": { "enum": ["error", "warn"] },
        "regex": { "type": "string", "minLength": 1, "maxLength": 300 },
        "flags": { "type": "string", "pattern": "^[ims]{0,3}$" },
        "title": { "$ref": "#/$defs/i18n" },
        "hint": { "$ref": "#/$defs/i18n" },
        "explanation": { "$ref": "#/$defs/i18n" },
        "suggestions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/suggestion" } }
      }
    }
  }
}
