  "platform-mcp": {
    "id": "platform-mcp",
    "legacyId": "mcp",
    "kind": "node",
    "profile": "full",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "MCP 服务",
      "en-US": "MCP server"
    },
    "description": {
      "zh-CN": "给 AI 客户端使用的本机 MCP 服务，只监听本机回环地址，需要访问密钥。",
      "en-US": "The local MCP server for AI clients. It listens on loopback only and needs its access key."
    },
    "dependsOn": [],
    "after": [
      "entry",
      "vllm-manager",
      "llama-manager"
    ],
    "ports": [
      {
        "name": "mcp",
        "port": 5190,
        "bind": "127.0.0.1",
        "enabled": true
      }
    ],
    "urls": {
      "mcp": "http://127.0.0.1:5190"
    },
    "readiness": {
      "intervalMs": 1000,
      "http": "http://127.0.0.1:5190/health",
      "expectJson": {
        "ok": true,
        "service": "local-ai-platform-mcp"
      },
      "timeoutSec": 20
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "cwd": "<AI_ROOT>/platform-mcp",
    "command": "node.exe",
    "args": [
      "dist/src/index.js"
    ],
    "argv": [
      "node.exe",
      "dist/src/index.js"
    ],
    "env": {
      "PLATFORM_MCP_SERVICE_ENTRY_URL": "http://127.0.0.1:5176",
      "PLATFORM_MCP_VLLM_MANAGER_URL": "http://127.0.0.1:5177",
      "PLATFORM_MCP_LLAMA_MANAGER_URL": "http://127.0.0.1:5178",
      "PLATFORM_MCP_PORT": "5190",
      "PLATFORM_MCP_TOOL_PROFILE": "all",
      "PLATFORM_MCP_OUTPUT_SCHEMA": "compact",
      "PLATFORM_MCP_SEARCH_RATE_LIMIT_PER_MINUTE": "20",
      "PLATFORM_MCP_LOCAL_RATE_LIMIT_PER_MINUTE": "120",
      "PLATFORM_MCP_CACHE_TTL_MS": "2000",
      "PLATFORM_MCP_API_KEY": "fake-mcp-key-0123456789abcdef0123456789abcdef",
      "PLATFORM_MCP_SEARCH_GATEWAY_API_KEY": "fake-search-key-0123456789",
      "PLATFORM_CONFIG_ENV_KEYS": "PLATFORM_MCP_API_KEY,PLATFORM_MCP_CACHE_TTL_MS,PLATFORM_MCP_LLAMA_MANAGER_URL,PLATFORM_MCP_LOCAL_RATE_LIMIT_PER_MINUTE,PLATFORM_MCP_OUTPUT_SCHEMA,PLATFORM_MCP_PORT,PLATFORM_MCP_SEARCH_GATEWAY_API_KEY,PLATFORM_MCP_SEARCH_RATE_LIMIT_PER_MINUTE,PLATFORM_MCP_SERVICE_ENTRY_URL,PLATFORM_MCP_TOOL_PROFILE,PLATFORM_MCP_VLLM_MANAGER_URL",
      "PLATFORM_CONFIG_FILE": "<AI_ROOT>/config/platform.json",
      "AI_ROOT": "<AI_ROOT>",
      "PLATFORM_MCP_HOST": "127.0.0.1",
      "PLATFORM_MCP_SEARCH_GATEWAY_URL": "http://127.0.0.1:5180",
      "PLATFORM_MCP_AUDIT_LOG": "<AI_ROOT>/audit-logs/platform-mcp.jsonl",
      "PLATFORM_MCP_ALLOWED_HOSTS": "127.0.0.1,localhost,::1,host.docker.internal"
    },
    "stop": {
      "strategy": "kill"
    },
    "hook": "platform-mcp",
    "docs": "/docs/mcp-platform-guide.md",
    "paths": [
      "platform-mcp/**"
    ],
    "requires": {
      "files": [
        "<AI_ROOT>/platform-mcp/dist/src/index.js"
      ],
      "doctor": [
        "env.mcp-dist"
      ]
    },
    "logDir": "<AI_ROOT>/logs/platform-mcp",
    "logs": {
      "out": "<AI_ROOT>/logs/platform-mcp/platform-mcp.out.log",
      "err": "<AI_ROOT>/logs/platform-mcp/platform-mcp.err.log"
    }
  },
  "tts-gateway": {
    "id": "tts-gateway",
    "legacyId": "tts",
    "kind": "process",
    "profile": "full",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "语音网关",
      "en-US": "TTS gateway"
    },
    "description": {
      "zh-CN": "语音合成网关。各语音引擎的工作进程按需单独启动。",
      "en-US": "The text-to-speech gateway. The engine workers start separately, on demand."
    },
    "dependsOn": [],
    "after": [
      "entry"
    ],
    "ports": [
      {
        "name": "http",
        "port": 7000,
        "bind": "127.0.0.1",
        "enabled": true
      }
    ],
    "urls": {
      "http": "http://127.0.0.1:7000"
    },
    "readiness": {
      "intervalMs": 1000,
      "http": "http://127.0.0.1:7000/health",
      "timeoutSec": 60
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "cwd": "<AI_ROOT>",
    "command": "pwsh.exe",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "tts-platform/scripts/start_gateway.ps1"
    ],
    "argv": [
      "pwsh.exe",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "tts-platform/scripts/start_gateway.ps1"
    ],
    "env": {
      "TTS_GATEWAY_PORT": "7000",
      "PLATFORM_CONFIG_ENV_KEYS": "TTS_GATEWAY_PORT",
      "PLATFORM_CONFIG_FILE": "<AI_ROOT>/config/platform.json"
    },
    "stop": {
      "strategy": "script-then-kill",
      "script": [
        "pwsh.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tts-platform/scripts/stop_gateway.ps1"
      ],
      "graceSec": 10,
      "tree": true
    },
    "paths": [
      "tts-platform/gateway/**",
      "tts-platform/scripts/**"
    ],
    "requires": {
      "files": [
        "<AI_ROOT>/tts-runtime/envs/gateway/Scripts/python.exe"
      ],
      "optional": true
    },
    "logDir": "<AI_ROOT>/logs/tts-gateway",
    "logs": {
      "out": "<AI_ROOT>/logs/tts-gateway/tts-gateway.out.log",
      "err": "<AI_ROOT>/logs/tts-gateway/tts-gateway.err.log"
    },
    "extraLogs": [
      "<AI_ROOT>/tts-runtime/state/gateway-stdout.log",
      "<AI_ROOT>/tts-runtime/state/gateway-stderr.log"
    ]
  },
  "tts-workers": {
    "id": "tts-workers",
    "kind": "group",
    "profile": "full",
    "autostart": false,
    "disabled": false,
    "label": {
      "zh-CN": "语音工作进程",
      "en-US": "TTS workers"
    },
    "description": {
      "zh-CN": "各语音引擎的工作进程，会加载较大的模型，只在需要时启动。",
      "en-US": "The speech engine workers. They load large models, so they start only on request."
    },
    "dependsOn": [
      "tts-gateway"
    ],
    "after": [],
    "ports": [],
    "urls": {},
