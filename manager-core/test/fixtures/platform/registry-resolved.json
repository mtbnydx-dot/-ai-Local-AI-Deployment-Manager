{
  "docker": {
    "id": "docker",
    "kind": "external",
    "profile": "core",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "Docker 引擎",
      "en-US": "Docker engine"
    },
    "description": {
      "zh-CN": "运行模型容器和搜索网关的 Docker 引擎。平台只负责确认它已启动，不会停止它。",
      "en-US": "The Docker engine that runs model containers and the search gateway. The platform only makes sure it is running and never stops it."
    },
    "dependsOn": [],
    "after": [],
    "ports": [],
    "urls": {},
    "readiness": {
      "intervalMs": 3000,
      "command": [
        "docker.exe",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ],
      "timeoutSec": 180
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "stop": {
      "strategy": "never"
    },
    "ensure": {
      "via": "docker-runtime",
      "mode": "start"
    },
    "docs": "/docs/troubleshooting.md#docker"
  },
  "entry": {
    "id": "entry",
    "legacyId": "entry",
    "kind": "node",
    "profile": "core",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "统一入口",
      "en-US": "Service entry"
    },
    "description": {
      "zh-CN": "控制台、网关和计费中心所在的统一入口（管理端口）。",
      "en-US": "The service entry that serves the console, the gateway and the billing center (admin port)."
    },
    "dependsOn": [],
    "after": [
      "docker"
    ],
    "ports": [
      {
        "name": "admin",
        "port": 5176,
        "bind": "127.0.0.1",
        "enabled": true
      }
    ],
    "urls": {
      "admin": "http://127.0.0.1:5176"
    },
    "readiness": {
      "intervalMs": 1000,
      "http": "http://127.0.0.1:5176/gateway/health",
      "expectJson": {
        "service": "local-ai-gateway"
      },
      "timeoutSec": 30
    },
    "liveness": {
      "timeoutMs": 2000,
      "onFailure": "report",
      "http": "http://127.0.0.1:5176/gateway/health",
      "intervalSec": 10,
      "failureThreshold": 6
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "cwd": "<AI_ROOT>/service-entry",
    "command": "node.exe",
    "args": [
      "server.js"
    ],
    "argv": [
      "node.exe",
      "server.js"
    ],
    "env": {
      "SERVICE_ENTRY_HOST": "127.0.0.1",
      "SERVICE_ENTRY_PORT": "5176",
      "SERVICE_ENTRY_ALLOW_LAN_ADMIN": "0",
      "SERVICE_ENTRY_PUBLIC_LISTENER": "1",
      "SERVICE_ENTRY_PUBLIC_HOST": "127.0.0.1",
      "SERVICE_ENTRY_PUBLIC_PORT": "5186",
      "SERVICE_ENTRY_RATE_LIMIT_RPM": "600",
      "SERVICE_ENTRY_TRUSTED_PROXIES": "127.0.0.1/32,::1/128",
      "SERVICE_ENTRY_CLIENT_IP_HEADER": "cf-connecting-ip",
      "SERVICE_ENTRY_REQUIRE_API_KEY": "auto",
      "VLLM_MANAGER_HOST": "127.0.0.1",
      "VLLM_MANAGER_PORT": "5177",
      "LLAMA_MANAGER_HOST": "127.0.0.1",
      "LLAMA_MANAGER_PORT": "5178",
      "SERVICE_ENTRY_CONSOLE_DEFAULT": "classic",
      "TTS_GATEWAY_PORT": "7000",
      "SEARCH_GATEWAY_PORT": "5180",
      "SERVICE_ENTRY_SEARCH_GATEWAY_KEY": "fake-search-key-0123456789",
      "HF_HOME": "<AI_ROOT>/cache/huggingface",
      "AI_AUDIT_MAX_EXPORTS": "30",
      "AI_AUDIT_MAX_AGE_DAYS": "90",
      "AI_AUDIT_REBASELINE_DAYS": "7",
      "AI_HUB_DOWNLOADS_OWNER": "hub",
      "SERVICE_ENTRY_AUTH_FAIL_LIMIT": "20",
      "SERVICE_ENTRY_AUTH_FAIL_WINDOW_SECONDS": "60",
      "SERVICE_ENTRY_AUTH_BAN_SECONDS": "600",
      "MANAGER_GATEWAY_ONLY": "warn",
      "TELEMETRY_ENABLED": "1",
      "TELEMETRY_SAMPLE_INTERVAL_MS": "10000",
      "PLATFORM_CONFIG_ENV_KEYS": "AI_AUDIT_MAX_AGE_DAYS,AI_AUDIT_MAX_EXPORTS,AI_AUDIT_REBASELINE_DAYS,AI_HUB_DOWNLOADS_OWNER,HF_HOME,LLAMA_MANAGER_HOST,LLAMA_MANAGER_PORT,MANAGER_GATEWAY_ONLY,SEARCH_GATEWAY_PORT,SERVICE_ENTRY_ALLOW_LAN_ADMIN,SERVICE_ENTRY_AUTH_BAN_SECONDS,SERVICE_ENTRY_AUTH_FAIL_LIMIT,SERVICE_ENTRY_AUTH_FAIL_WINDOW_SECONDS,SERVICE_ENTRY_CLIENT_IP_HEADER,SERVICE_ENTRY_CONSOLE_DEFAULT,SERVICE_ENTRY_HOST,SERVICE_ENTRY_PORT,SERVICE_ENTRY_PUBLIC_HOST,SERVICE_ENTRY_PUBLIC_LISTENER,SERVICE_ENTRY_PUBLIC_PORT,SERVICE_ENTRY_RATE_LIMIT_RPM,SERVICE_ENTRY_REQUIRE_API_KEY,SERVICE_ENTRY_SEARCH_GATEWAY_KEY,SERVICE_ENTRY_TRUSTED_PROXIES,TELEMETRY_ENABLED,TELEMETRY_SAMPLE_INTERVAL_MS,TTS_GATEWAY_PORT,VLLM_MANAGER_HOST,VLLM_MANAGER_PORT",
      "PLATFORM_CONFIG_FILE": "<AI_ROOT>/config/platform.json",
      "AI_ROOT": "<AI_ROOT>"
    },
    "stop": {
      "strategy": "http-then-kill",
      "http": "http://127.0.0.1:5176/api/manager/shutdown",
      "auth": "system",
      "graceSec": 15
    },
    "busy": {
      "http": "http://127.0.0.1:5176/api/platform/busy",
      "parser": "entry-busy",
      "auth": "system"
    },
    "paths": [
      "service-entry/**",
      "manager-core/**",
      "!manager-core/platform/**",
      "shared-public/**"
    ],
    "logDir": "<AI_ROOT>/logs/entry",
    "logs": {
      "out": "<AI_ROOT>/logs/entry/entry.out.log",
      "err": "<AI_ROOT>/logs/entry/entry.err.log"
    }
  },
  "service-entry-public": {
    "id": "service-entry-public",
    "kind": "listener",
    "profile": "core",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "公网入口监听",
      "en-US": "Public listener"
    },
    "description": {
      "zh-CN": "统一入口进程里的公网监听端口，是 Cloudflare 隧道或反向代理唯一应该指向的地址。",
      "en-US": "The public listening port inside the service entry process; the only address a Cloudflare tunnel or reverse proxy should target."
    },
    "parent": "entry",
    "dependsOn": [],
    "after": [],
    "ports": [
      {
        "name": "public",
        "port": 5186,
        "bind": "127.0.0.1",
        "enabled": true
      }
    ],
    "urls": {
      "public": "http://127.0.0.1:5186"
    },
    "readiness": {
      "intervalMs": 1000,
      "http": "http://127.0.0.1:5186/healthz",
      "expectStatus": 200,
      "timeoutSec": 30
    },
    "liveness": {
      "timeoutMs": 2000,
      "onFailure": "report",
      "http": "http://127.0.0.1:5186/healthz",
      "intervalSec": 15,
      "failureThreshold": 4
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "enabled": true,
    "stop": {
      "strategy": "never"
    },
    "docs": "/docs/client-setup-guide.md#public"
  },
  "vllm-manager": {
    "id": "vllm-manager",
    "legacyId": "vllm",
    "kind": "node",
    "profile": "core",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "vLLM / SGLang 管理器",
      "en-US": "vLLM / SGLang manager"
    },
    "description": {
      "zh-CN": "启动和管理 vLLM、SGLang 模型容器的管理器。停止管理器不会停止模型容器。",
      "en-US": "The manager that launches and supervises vLLM and SGLang model containers. Stopping it leaves the model containers running."
    },
    "dependsOn": [],
    "after": [
      "entry",
      "docker"
    ],
    "ports": [
      {
        "name": "api",
        "port": 5177,
        "bind": "127.0.0.1",
        "enabled": true
      }
    ],
    "urls": {
      "api": "http://127.0.0.1:5177"
    },
    "readiness": {
      "intervalMs": 1000,
      "http": "http://127.0.0.1:5177/api/manager/health",
      "expectJson": {
        "ok": true
      },
      "timeoutSec": 30
    },
    "liveness": {
      "timeoutMs": 2000,
      "onFailure": "report",
      "http": "http://127.0.0.1:5177/api/manager/health",
      "intervalSec": 10,
      "failureThreshold": 6
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "cwd": "<AI_ROOT>/vllm-manager",
    "command": "node.exe",
    "args": [
      "server.js"
    ],
    "argv": [
      "node.exe",
      "server.js"
    ],
    "env": {
      "VLLM_MANAGER_HOST": "127.0.0.1",
      "VLLM_MANAGER_PORT": "5177",
      "HF_HOME": "<AI_ROOT>/cache/huggingface",
      "AI_AUDIT_MAX_EXPORTS": "30",
      "AI_AUDIT_MAX_AGE_DAYS": "90",
      "AI_AUDIT_REBASELINE_DAYS": "7",
      "AI_HUB_DOWNLOADS_OWNER": "hub",
      "MANAGER_GATEWAY_ONLY": "warn",
      "STATS_SAMPLE_INTERVAL_MS": "10000",
      "PLATFORM_CONFIG_ENV_KEYS": "AI_AUDIT_MAX_AGE_DAYS,AI_AUDIT_MAX_EXPORTS,AI_AUDIT_REBASELINE_DAYS,AI_HUB_DOWNLOADS_OWNER,HF_HOME,MANAGER_GATEWAY_ONLY,STATS_SAMPLE_INTERVAL_MS,VLLM_MANAGER_HOST,VLLM_MANAGER_PORT",
      "PLATFORM_CONFIG_FILE": "<AI_ROOT>/config/platform.json",
      "AI_ROOT": "<AI_ROOT>",
      "VLLM_MANAGER_ALLOW_REMOTE": "0"
    },
    "stop": {
      "strategy": "http-then-kill",
      "http": "http://127.0.0.1:5177/api/manager/shutdown",
      "graceSec": 15
    },
    "busy": {
      "http": "http://127.0.0.1:5177/api/jobs?fields=summary",
      "parser": "manager-jobs"
    },
    "paths": [
      "vllm-manager/**",
      "manager-core/**",
      "!manager-core/platform/**",
      "shared-public/**"
    ],
    "logDir": "<AI_ROOT>/logs/vllm-manager",
    "logs": {
      "out": "<AI_ROOT>/logs/vllm-manager/vllm-manager.out.log",
      "err": "<AI_ROOT>/logs/vllm-manager/vllm-manager.err.log"
    }
  },
