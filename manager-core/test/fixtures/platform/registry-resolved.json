  "search-gateway": {
    "id": "search-gateway",
    "legacyId": "search",
    "kind": "compose",
    "profile": "full",
    "autostart": true,
    "disabled": false,
    "label": {
      "zh-CN": "联网搜索网关",
      "en-US": "Web search gateway"
    },
    "description": {
      "zh-CN": "在 Docker 里运行的联网搜索网关（含 SearXNG），通过本机模型回答带搜索的问题。",
      "en-US": "The web search gateway with SearXNG, running in Docker. It answers search-augmented chats through a local model."
    },
    "dependsOn": [
      "docker"
    ],
    "after": [
      "entry"
    ],
    "ports": [
      {
        "name": "http",
        "port": 5180,
        "bind": "127.0.0.1",
        "enabled": true
      },
      {
        "name": "searxng",
        "port": 8180,
        "bind": "127.0.0.1",
        "enabled": true
      }
    ],
    "urls": {
      "http": "http://127.0.0.1:5180",
      "searxng": "http://127.0.0.1:8180"
    },
    "readiness": {
      "intervalMs": 1000,
      "http": "http://127.0.0.1:5180/health",
      "expectJson": {
        "service": "local-ai-search-gateway"
      },
      "timeoutSec": 180
    },
    "restartPolicy": {
      "mode": "docker",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
    },
    "cwd": "<AI_ROOT>",
    "env": {
      "SERVICE_ENTRY_PORT": "5176",
      "SERVICE_ENTRY_PUBLIC_PORT": "5186",
      "SEARCH_GATEWAY_PORT": "5180",
      "SEARCH_GATEWAY_API_KEY": "fake-search-key-0123456789",
      "UPSTREAM_API_KEY": "fake-upstream-key-0123456789",
      "PLATFORM_CONFIG_ENV_KEYS": "SEARCH_GATEWAY_API_KEY,SEARCH_GATEWAY_PORT,SERVICE_ENTRY_PORT,SERVICE_ENTRY_PUBLIC_PORT,UPSTREAM_API_KEY",
      "PLATFORM_CONFIG_FILE": "<AI_ROOT>/config/platform.json"
    },
    "compose": {
      "file": "<AI_ROOT>/search-gateway/docker-compose.yml",
      "project": "local-ai-search",
      "build": "if-changed"
    },
    "stop": {
      "strategy": "compose",
      "action": "down"
    },
    "hook": "search-gateway",
    "paths": [
      "search-gateway/**"
    ]
  },
  "legacy-claude-proxy": {
    "id": "legacy-claude-proxy",
    "kind": "external",
    "profile": "none",
    "autostart": false,
    "disabled": false,
    "label": {
      "zh-CN": "旧版 Claude 代理",
      "en-US": "Legacy Claude proxy"
    },
    "description": {
      "zh-CN": "旧的 8001 端口 Claude 代理。它绕过网关鉴权，平台只检测、不启动也不停止它。",
      "en-US": "The old Claude proxy on port 8001. It bypasses gateway authentication; the platform only detects it and never starts or stops it."
    },
    "deprecated": true,
    "detectOnly": true,
