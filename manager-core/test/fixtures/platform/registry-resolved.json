        "enabled": true
      }
    ],
    "urls": {
      "http": "http://127.0.0.1:8001"
    },
    "restartPolicy": {
      "mode": "on-failure",
      "maxRestarts": 5,
      "windowSec": 600,
      "backoffSec": [
        1,
        2,
        5,
        15,
        30,
        60
      ],
      "stableAfterSec": 600
