{
  "description": "Reference values for histogram_quantile from the Prometheus PromQL test data (promql/promqltest/testdata/histograms.test). Each series is a cumulative bucket counter that grows by `perStep` every 5 minutes; the values below are read at 50m (10 steps).",
  "quantileCases": [
    {
      "name": "testhistogram, start=positive",
      "le": [0.1, 0.2, 1, "+Inf"],
      "counts": [50, 70, 110, 120],
      "expected": [[-0.1, "-Inf"], [1.01, "+Inf"], [0, 0], [0.2, 0.048], [0.5, 0.15], [0.8, 0.72], [1, 1]]
    },
    {
      "name": "testhistogram, start=negative",
      "le": [-0.2, -0.1, 0.3, "+Inf"],
      "counts": [10, 20, 20, 30],
      "expected": [[-0.1, "-Inf"], [1.01, "+Inf"], [0, -0.2], [0.2, -0.2], [0.5, -0.15], [0.8, 0.3], [1, 0.3]]
    },
    {
      "name": "nonmonotonic_bucket (counts are made monotonic first)",
      "le": [0.1, 1, 10, 100, 1000, "+Inf"],
      "counts": [20, 10, 50, 40, 90, 80],
      "expected": [[0.01, 0.0045], [0.5, 8.5], [0.99, 979.75]]
    }
  ],
  "rateCase": {
    "name": "request_duration_seconds: histogram_quantile(q, sum(rate(request_duration_seconds_bucket[5m])) by (le))",
    "le": [0.1, 0.2, "+Inf"],
    "perStep": [
      { "series": "job1/ins1", "counts": [1, 3, 4] },
      { "series": "job1/ins2", "counts": [2, 5, 6] },
      { "series": "job2/ins1", "counts": [3, 4, 6] },
      { "series": "job2/ins2", "counts": [4, 7, 9] }
    ],
    "fromStep": 9,
    "toStep": 10,
    "expected": [[0.3, 0.075], [0.5, 0.1277777777777778]]
  }
}
